{
  "name": "AquakartCrm",
  "private": true,
  "version": "1.0.52",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "npx serve -s dist -l 4000",
    "lint": "npm run ui:audit && eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "pretty": "npx prettier --write .",
    "format": "npm run pretty && npm run lint:fix",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "husky",
    "docs:scan": "node scripts/scan-components.cjs",
    "ui:audit": "node scripts/check-ui-consistency.cjs",
    "ui:strict": "node scripts/check-ui-consistency.cjs --strict"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md}": [
      "npx prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.46.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jspdf": "^1.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
